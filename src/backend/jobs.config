{
  "jobs": [
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "sendDailyDigest",
      "description": "Send daily newsletter digest to subscribers at 9 AM",
      "executionConfig": {
        "cronExpression": "0 9 * * *"
      }
    },
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "sendWeeklyDigest",
      "description": "Send weekly newsletter digest every Monday at 9 AM",
      "executionConfig": {
        "cronExpression": "0 9 * * 1"
      }
    },
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "updateSiteStats",
      "description": "Update site statistics daily at midnight",
      "executionConfig": {
        "cronExpression": "0 0 * * *"
      }
    },
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "cleanupOldData",
      "description": "Clean up old messages and logs every Sunday at 3 AM",
      "executionConfig": {
        "cronExpression": "0 3 * * 0"
      }
    }
  ]
}
