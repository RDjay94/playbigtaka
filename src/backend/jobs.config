{
  "jobs": [
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "cleanupOldMessages",
      "description": "Remove contact messages older than 90 days",
      "executionConfig": {
        "cronExpression": "0 3 * * 0"
      }
    },
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "sendWeeklyDigest",
      "description": "Send weekly newsletter digest to subscribers every Monday at 9 AM",
      "executionConfig": {
        "cronExpression": "0 9 * * 1"
      }
    },
    {
      "functionLocation": "/backend/scheduledJobs.js",
      "functionName": "updateSiteStats",
      "description": "Update site statistics daily at midnight",
      "executionConfig": {
        "cronExpression": "0 0 * * *"
      }
    }
  ]
}
