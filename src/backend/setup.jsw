// ═══════════════════════════════════════════════════════════════════════
// SETUP FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════

/**
 * Main setup function — seeds categories and articles.
 * Safe to run multiple times (checks for existing data).
 * Call from browser console: import { setupSite } from 'backend/setup.jsw'; setupSite();
 * @returns {Promise<Object>} — { success, categoriesAdded, articlesAdded }
 */
export async function setupSite() {
  try {
    const catResult = await seedCategories();
    const artResult = await seedArticles();

    return {
      success: true,
      categoriesAdded: catResult,
      articlesAdded: artResult,
      message: `Setup complete! Added ${catResult} categories and ${artResult} articles.`
    };
  } catch (err) {
    return { success: false, error: err.message };
  }
}

async function seedCategories() {
  const existing = await wixData.query('Categories').find();
  if (existing.items.length > 0) {
    console.log('Categories already exist — skipping seed.');
    return 0;
  }

  let count = 0;
  for (const cat of CATEGORIES) {
    await wixData.insert('Categories', cat);
    count++;
  }
  console.log(`Seeded ${count} categories.`);
  return count;
}

async function seedArticles() {
  const existing = await wixData.query('Articles').find();
  if (existing.items.length > 0) {
    console.log('Articles already exist — skipping seed.');
    return 0;
  }

  let count = 0;
  for (const article of ARTICLES) {
    await wixData.insert('Articles', article);
    count++;
  }
  console.log(`Seeded ${count} articles.`);
  return count;
}

/**
 * Resets all data — USE WITH CAUTION. Deletes all articles, categories, subscribers.
 * @returns {Promise<Object>}
 */
export async function resetAllData() {
  const collections = ['Articles', 'Categories', 'Subscribers', 'ContactMessages', 'NewsletterLogs', 'SiteStats'];

  for (const col of collections) {
    try {
      const results = await wixData.query(col).limit(1000).find();
      for (const item of results.items) {
        await wixData.remove(col, item._id);
      }
      console.log(`Cleared ${results.items.length} items from ${col}`);
    } catch (_) {
      console.log(`Collection ${col} doesn't exist yet — skipping.`);
    }
  }

  return { success: true, message: 'All data cleared. Run setupSite() to re-seed.' };
}
